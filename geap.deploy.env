# Office environment — self-contained config for the office deployment.
# Sourced by build.sh and deploy.sh. Every variable
# here is also present in deploy.personal.env (with different values), so
# picking which file you source is what picks which environment you deploy to.
#
# All values use "${VAR:-default}" so you can still override per-run:
#   PROJECT_ID=my-project ./deploy.sh

# --- GCP project / region ---------------------------------------------------
export PROJECT_ID="${PROJECT_ID:-labs-gcp-msls-16495-1782829337}"
export REGION="${REGION:-us-east1}"

# --- Model -----------------------------------------------------------------
# Matches app/config/models.py's DEFAULT_MODEL (gemini-2.5-flash).
export AGENT_MODEL="${AGENT_MODEL:-gemini-2.5-flash}"
export MODEL_LOCATION="${MODEL_LOCATION:-global}"

# --- Remote MCP portfolio server --------------------------------------------
# The deployed portfolio server speaks Streamable HTTP at /mcp (not SSE).
# TODO: confirm the office MCP service URL; update if different.
export MCP_PORTFOLIO_URL="${MCP_PORTFOLIO_URL:-https://mcp-portfolio-492310803820.us-east1.run.app/mcp}"

# --- MCP portfolio server via API Registry ----------------------------------
# Preferred connection: register the portfolio MCP server in the Google Cloud
# API Registry and reference it by its full resource name. The registry
# provides discovery + auth so no raw URL needs to be baked into the agent.
# MCP_REGISTRY_SERVER format:
#   projects/<project>/locations/<location>/mcpServers/<name>
export MCP_REGISTRY_PROJECT_ID="${MCP_REGISTRY_PROJECT_ID:-${PROJECT_ID}}"
export MCP_REGISTRY_LOCATION="${MCP_REGISTRY_LOCATION:-us-east1}"
# Full resource name of the registered portfolio MCP server (from
# `gcloud agent-registry mcp-servers list`). NOTE: the office project's
# registry must have the server registered at this name.
export MCP_REGISTRY_SERVER="${MCP_REGISTRY_SERVER:-projects/492310803820/locations/us-east1/mcpServers/agentregistry-00000000-0000-0000-b624-c3ae387e34b9}"

# --- Vertex AI Memory Bank ---------------------------------------------------
# Instance ID of the Memory Bank to use for long-term agent memory (e.g. '456'
# in projects/.../reasoningEngines/456). Defaults to the agent-engine id.
export MEMORY_BANK_ID="${MEMORY_BANK_ID:-}"

# --- Financial planner (A2A on Agent Runtime) --------------------------------
# Full ReasoningEngine resource name of the deployed financial planner. The
# supervisor's call_financial_planner tool reads this at runtime and invokes the
# planner's on_message_send operation through the Agent Platform SDK.
#
# Agent Runtime serves no public agent card, so there is no card URL to
# configure — the engine is addressed by resource name. The value is printed by
# the planner's deploy.a2a.sh.
export FINANCIAL_PLANNER_ENGINE="${FINANCIAL_PLANNER_ENGINE:-projects/labs-gcp-msls-16495-1782829337/locations/us-east1/reasoningEngines/PLACEHOLDER}"
