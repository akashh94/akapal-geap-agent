# Copy to .env for local deploys and point it at your target project
# (see config/<name>.env for the known targets). Never commit .env.
# CI does not use this file — targets live in GitHub Environments.

GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=my-gcp-project
GOOGLE_CLOUD_LOCATION=us-west1

# Optional override
AGENT_DISPLAY_NAME=GEAP Orchestrator

# The deployed agent's own environment (AGENT_MODEL, MODEL_LOCATION, ...)
# is declared in geap_agent/.agent_engine_config.json, not here.
